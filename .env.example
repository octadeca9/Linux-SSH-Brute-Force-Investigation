# Copy to .env for local development: cp .env.example .env
APP_ENV=development
SESSION_ID=local-dev-session

# --- Mode ---------------------------------------------------------------------
# TASKS_ENABLED=true  (default) full lab: log viewer + task panel + scoring.
# TASKS_ENABLED=false viewer-only: ONLY the SSH authentication log dashboard.
#   No task panel, no scoring, submission/session endpoints return 404, and the
#   validator/ground truth is never loaded (GROUND_TRUTH_* below not needed).
#   Use this when answers/scoring are handled by an external SOC platform.
TASKS_ENABLED=true

# --- Ground truth (answer key) source ---------------------------------------
# The validator needs the answer key at runtime. It must NOT be baked into the
# image. Provide it ONE of three ways (checked in this order):
#
#   1. GROUND_TRUTH_B64  — base64 of config/ground_truth.yaml. Recommended for
#      env-only platforms that expose key/value variables but no file mounts.
#      Generate with:
#        base64 < config/ground_truth.yaml | tr -d '\n'
#      GROUND_TRUTH_B64=...
#
#   2. GROUND_TRUTH_YAML — the raw YAML content as a single variable value.
#      GROUND_TRUTH_YAML=
#
#   3. GROUND_TRUTH_PATH — a file path (used by docker-compose which mounts the
#      file read-only at /run/secrets/ground_truth.yaml).
#      GROUND_TRUTH_PATH=/run/secrets/ground_truth.yaml
